# Dependencies
node_modules/

# Build output (tsc for api/shared, vite build for web)
dist/

# TypeScript incremental build info
*.tsbuildinfo

# Environment variables (Supabase keys land here starting W1)
.env
.env.*
!.env.example

# Editor / OS
.vscode/
.idea/
.DS_Store

# Claude Code: ignore everything under .claude/ except the shared, checked-in
# team config (settings.json + hooks). Personal overrides live in the
# still-ignored settings.local.json.
.claude/*
!.claude/settings.json
!.claude/hooks/

# Playwright MCP browser-testing artifacts (screenshots, snapshots, console logs)
.playwright-mcp/

# Claude Design handoff files (screens, uploads, exports) — reference only, not shipped code
design/

# Logs
*.log

# Test coverage (if/when enabled)
coverage/
