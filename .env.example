# Local Postgres (docker compose up -d). In production this points at the
# Supabase project's own Postgres instead (Project Settings -> Database ->
# Connection string, "Transaction pooler" URI) — TEST_DATABASE_URL has no
# production equivalent, it's local-only.
DATABASE_URL=postgres://tallyup:tallyup@localhost:5432/tallyup_dev
TEST_DATABASE_URL=postgres://tallyup:tallyup@localhost:5432/tallyup_test

# Supabase project — Auth only (Postgres stays local, see above). Project
# Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# Secret — server-side only, used to admin-create the seeded demo staff
# login. Never exposed to web. Local dev / seed script only — the deployed
# api never needs this and it is deliberately not set on Render.
SUPABASE_SERVICE_ROLE_KEY=

# Optional locally (defaults to http://localhost:5173). Required in
# production — the deployed Vercel URL, e.g. https://tallyup.vercel.app
CORS_ORIGIN=
